{
  "name": "arcsync",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Sync Start — synchronized multiplayer countdown",
  "scripts": {
    "lint:js": "eslint web/js/*.js",
    "lint:css": "stylelint 'web/css/*.css'",
    "lint": "npm run lint:js && npm run lint:css",
    "test:js": "jest",
    "test": "jest"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/web/js/*.test.js"]
  }
}
